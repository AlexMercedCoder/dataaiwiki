---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaStrip from '../components/CtaStrip.astro';
import SearchBox from '../components/SearchBox.astro';
import networkHead from '../../network/network-head.html?raw';
import network from '../../network/network.json';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  isArticle?: boolean;
  image?: string;
  /** 'term' marks a single definition page; 'termset' marks a glossary listing. */
  kind?: 'term' | 'termset';
  /** Terms to list in the DefinedTermSet on a glossary listing page. */
  terms?: { name: string; url: string }[];
}

const {
  title,
  description = "Alex Merced's Data & AI Wiki: short definitions of AI and data terms, from agents and retrieval to semantic layers and lakehouses.",
  isArticle = false,
  image = "/og-image.png",
  kind,
  terms,
} = Astro.props;

// Ensure we have a valid canonical URL
const siteUrl = Astro.site ? Astro.site.toString() : 'https://dataaiwiki.com/';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl);

// Resolve the full title to avoid double appending the brand name
const fullTitle = title.includes("Data & AI Wiki") ? title : `${title} | Data & AI Wiki`;

const author = { "@id": "https://alexmerced.com/#alexmerced" };
const termSetId = new URL('/#termset', siteUrl).toString();
const websiteRef = { "@type": "WebSite", "name": "Data & AI Wiki", "url": siteUrl };

const termSet = {
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": termSetId,
  "name": "Data & AI Wiki",
  "description": "Short definitions of AI and data terms by Alex Merced.",
  "url": new URL('/wiki/terms/', siteUrl).toString(),
  "creator": author,
  ...(terms && terms.length
    ? { "hasDefinedTerm": terms.map(t => ({ "@type": "DefinedTerm", "name": t.name, "url": t.url })) }
    : {}),
};

// Create JSON-LD schema
const schema = kind === 'term'
  ? {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": fullTitle,
      "description": description,
      "url": canonicalURL.toString(),
      "image": imageUrl.toString(),
      "inLanguage": "en",
      "author": author,
      "isPartOf": websiteRef,
      "mainEntity": {
        "@type": "DefinedTerm",
        "@id": `${canonicalURL.toString()}#term`,
        "name": title,
        "description": description,
        "url": canonicalURL.toString(),
        "inDefinedTermSet": { "@id": termSetId },
      },
    }
  : isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": fullTitle,
      "description": description,
      "url": canonicalURL.toString(),
      "image": imageUrl.toString(),
      "inLanguage": "en",
      "author": author,
      "isPartOf": websiteRef
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": fullTitle,
      "description": description,
      "url": canonicalURL.toString(),
      "image": imageUrl.toString(),
      "author": author
    };

const breadcrumbSchema = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
        { "@type": "ListItem", "position": 2, "name": "Wiki", "item": new URL('/wiki/', siteUrl).toString() },
        { "@type": "ListItem", "position": 3, "name": title, "item": canonicalURL.toString() }
      ]
    }
  : null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300..700;1,300..700&display=swap" rel="stylesheet" />

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />

    <meta property="og:site_name" content="Data & AI Wiki" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={network.twitterSite} />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
    {kind === 'termset' && <script type="application/ld+json" set:html={JSON.stringify(termSet)} />}

    <!-- Network head: GA4, event listener, canonical Person JSON-LD (generated) -->
    <Fragment set:html={networkHead} />
  </head>
  <body>
    <!-- Accessibility Skip to Content -->
    <a href="#main-content" class="skip-link">Skip to Content</a>

    <Header />
    <slot />
    <CtaStrip />
    <Footer />
    <SearchBox />
    <!-- WebMCP: read-only tools for browser AI agents. Progressive enhancement;
       no effect where WebMCP is unsupported. Config in /webmcp/init.js -->
  <script src="/webmcp/alex-merced-webmcp.js" defer></script>
  <script src="/webmcp/init.js" defer></script>
</body>
</html>
