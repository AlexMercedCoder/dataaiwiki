---
---
<div id="search-modal" class="search-modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="search-modal-title">
  <div class="search-modal-backdrop" id="search-backdrop"></div>
  <div class="search-modal-content">
    <div class="search-modal-header">
      <h2 id="search-modal-title" class="search-title">Search Data &amp; AI Wiki</h2>
      <button id="search-close" class="close-btn" aria-label="Close search" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    
    <div class="search-modal-body">
      <div class="search-input-wrapper">
        <input 
          type="search" 
          id="search-input" 
          placeholder="Type to search terms, guides, platforms..." 
          aria-label="Search text"
          autocomplete="off"
        />
      </div>
      <div id="search-loading" class="search-loading" style="display: none;">Searching...</div>
      <div id="search-results-list" class="search-results-list" aria-live="polite"></div>
      <div id="search-no-results" class="search-no-results" style="display: none;">No matches found.</div>
    </div>
    
    <div class="search-modal-footer">
      <kbd>ESC</kbd> to close &bull; <kbd>TAB</kbd> to navigate
    </div>
  </div>
</div>

<script>
  let pagefindInstance: any = null;

  const loadPagefind = async () => {
    if (pagefindInstance) return pagefindInstance;
    try {
      // Dynamic import of pagefind library output (generated post-build)
      // Use variable to prevent Vite from statically analyzing and failing dev compilation
      const pagefindPath = '/pagefind/pagefind.js';
      const pagefind = await import(/* @vite-ignore */ pagefindPath);
      await pagefind.init();
      pagefindInstance = pagefind;
      return pagefind;
    } catch (e) {
      console.error("Failed to load pagefind search index", e);
      return null;
    }
  };

  const initSearch = () => {
    const trigger = document.getElementById('search-trigger');
    const modal = document.getElementById('search-modal');
    const closeBtn = document.getElementById('search-close');
    const backdrop = document.getElementById('search-backdrop');
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const resultsContainer = document.getElementById('search-results-list');
    const noResults = document.getElementById('search-no-results');
    const loading = document.getElementById('search-loading');

    if (!modal || !input || !resultsContainer || !noResults || !loading) return;

    const openModal = () => {
      modal.setAttribute('aria-hidden', 'false');
      modal.classList.add('open');
      document.body.style.overflow = 'hidden';
      setTimeout(() => input.focus(), 100);
      loadPagefind(); // Pre-load pagefind
    };

    const closeModal = () => {
      modal.setAttribute('aria-hidden', 'true');
      modal.classList.remove('open');
      document.body.style.overflow = '';
      input.value = '';
      resultsContainer.innerHTML = '';
      noResults.style.display = 'none';
      if (trigger) trigger.focus();
    };

    if (trigger) {
      trigger.addEventListener('click', openModal);
    }
    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }
    if (backdrop) {
      backdrop.addEventListener('click', closeModal);
    }

    // Close on ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeModal();
      }
    });

    // Handle search query input
    let debounceTimer: any;
    input.addEventListener('input', (e) => {
      clearTimeout(debounceTimer);
      const query = (e.target as HTMLInputElement).value.trim();

      if (query.length < 2) {
        resultsContainer.innerHTML = '';
        noResults.style.display = 'none';
        loading.style.display = 'none';
        return;
      }

      loading.style.display = 'block';
      noResults.style.display = 'none';

      debounceTimer = setTimeout(async () => {
        const pagefind = await loadPagefind();
        if (!pagefind) {
          loading.style.display = 'none';
          return;
        }

        const search = await pagefind.search(query);
        
        if (search.results.length === 0) {
          resultsContainer.innerHTML = '';
          noResults.style.display = 'block';
          loading.style.display = 'none';
          return;
        }

        // Fetch first 8 results details
        const dataPromises = search.results.slice(0, 8).map((r: any) => r.data());
        const results = await Promise.all(dataPromises);

        resultsContainer.innerHTML = '';
        noResults.style.display = 'none';
        loading.style.display = 'none';

        results.forEach((res: any) => {
          const item = document.createElement('div');
          item.className = 'search-result-item';
          
          // Re-route links cleanly
          let href = res.url;
          
          item.innerHTML = `
            <a href="${href}">
              <h4 class="search-result-title">${res.meta.title || 'Untitled'}</h4>
              <p class="search-result-excerpt">${res.excerpt}</p>
            </a>
          `;
          resultsContainer.appendChild(item);
        });
      }, 250);
    });
  };

  // Run on page load
  initSearch();
  // Support Astro View Transitions
  document.addEventListener('astro:after-swap', initSearch);
</script>

<style>
  .search-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .search-modal.open {
    display: flex;
  }

  .search-modal-backdrop {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(71, 36, 37, 0.4);
    backdrop-filter: blur(4px);
  }

  .search-modal-content {
    position: relative;
    background-color: var(--color-canvas-parchment);
    border: 1px solid var(--color-border);
    width: 100%;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    max-height: 80vh;
    z-index: 10001;
    box-shadow: none; /* Keep Refero design flat style */
  }

  .search-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .search-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    margin: 0;
    line-height: 1.1;
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--color-text-main);
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 0.25rem;
  }

  .close-btn:hover {
    color: var(--color-alert-crimson);
  }

  .search-modal-body {
    padding: 1.5rem;
    overflow-y: auto;
    flex-grow: 1;
  }

  .search-input-wrapper {
    margin-bottom: 1.5rem;
  }

  #search-input {
    width: 100%;
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    padding: 0.75rem 1rem;
    font-family: var(--font-primary);
    font-size: 1rem;
  }

  #search-input:focus {
    outline: 2px dashed var(--color-alert-crimson);
    outline-offset: -2px;
  }

  .search-loading {
    font-size: 0.95rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .search-results-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .search-result-item {
    border: 1px solid var(--color-border);
    background-color: var(--color-pure-white);
    transition: all 0.2s ease;
  }

  .search-result-item a {
    display: block;
    padding: 1rem;
    text-decoration: none;
    color: var(--color-text-main);
  }

  .search-result-item:hover {
    border-color: var(--color-alert-crimson);
    background-color: var(--color-canvas-parchment);
  }

  .search-result-item:hover .search-result-title {
    color: var(--color-alert-crimson);
  }

  .search-result-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    margin: 0 0 0.5rem 0;
    font-weight: normal;
  }

  .search-result-excerpt {
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Mark highlighted terms returned by pagefind */
  .search-result-excerpt mark {
    background-color: rgba(231, 55, 55, 0.15);
    color: var(--color-alert-crimson);
    font-weight: 600;
  }

  .search-no-results {
    font-size: 1rem;
    font-style: italic;
    color: var(--color-text-muted);
    padding: 1rem 0;
  }

  .search-modal-footer {
    padding: 1rem 1.5rem;
    border-top: 1px dashed var(--color-border);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  kbd {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-border);
    padding: 0.1rem 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: bold;
  }
</style>
