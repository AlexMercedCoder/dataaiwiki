---
---
<header class="site-header">
  <div class="header-container container">
    <a href="/" class="site-logo">
      <span>Data & AI Wiki</span>
    </a>
    
    <nav class="header-nav" aria-label="Main Navigation">
      <a href="/">Home</a>
      <a href="/wiki/">Wiki</a>
      <a href="/books/">Books</a>
      <a href="https://github.com/AlexMercedCoder/dataaiwiki" target="_blank" rel="noopener noreferrer" class="github-link">GitHub</a>
      <button id="search-trigger" class="search-btn" aria-label="Open Search" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <span>Search</span>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header {
    height: var(--header-height);
    background-color: var(--color-canvas-parchment);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .site-logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-text-main);
    text-decoration: none;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
  }

  .site-logo:hover {
    color: var(--color-alert-crimson);
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header-nav a {
    color: var(--color-text-main);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
  }

  .header-nav a:hover {
    color: var(--color-alert-crimson);
    border-bottom: 1px dashed var(--color-alert-crimson);
  }

  .search-btn {
    background: var(--color-pure-white);
    border: 1px solid var(--color-border);
    color: var(--color-text-main);
    padding: 0.4rem 0.8rem;
    font-family: var(--font-primary);
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  .search-btn:hover {
    background-color: var(--color-canvas-parchment);
    border-color: var(--color-alert-crimson);
    color: var(--color-alert-crimson);
  }

  .search-icon {
    display: inline-block;
    vertical-align: middle;
  }

  @media (max-width: 480px) {
    .github-link {
      display: none;
    }
  }
</style>
