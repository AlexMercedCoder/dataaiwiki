---
const links = [
  { label: 'AlexMerced.com', url: 'https://alexmerced.com' },
  { label: 'AlexMercedData.com', url: 'https://alexmerceddata.com' },
  { label: 'Books by Alex Merced', url: 'https://books.alexmerced.com' },
  { label: 'DataLakehouseHub.com', url: 'https://datalakehousehub.com' },
  { label: 'SemanticLakehouse.com', url: 'https://semanticlakehouse.com' },
  { label: 'OpenDataLakehouse.com', url: 'https://opendatalakehouse.com' },
  { label: 'AgenticLakehouse.com', url: 'https://agenticlakehouse.com' },
  { label: 'OpenLakehouse.help', url: 'https://openlakehouse.help' },
];

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container container">
    <div class="footer-links-grid">
      {links.map(link => (
        <a 
          href={link.url} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="footer-link"
        >
          {link.label}
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      ))}
    </div>
    
    <div class="footer-bottom">
      <p class="copyright">&copy; {currentYear} Data & AI Wiki. Developed under the Refero Editorial Style.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-canvas-parchment);
    padding: 3rem 0;
    margin-top: auto;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1.5rem;
  }

  .footer-link {
    color: var(--color-text-main);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem;
    border: 1px dashed transparent;
    text-align: center;
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-alert-crimson);
    border-color: var(--color-alert-crimson);
    background-color: var(--color-canvas-parchment);
  }

  .footer-bottom {
    display: flex;
    justify-content: center;
    border-top: 1px dashed var(--color-border);
    padding-top: 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .copyright {
    margin: 0;
    text-align: center;
  }

  /* Screen Reader helper */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
