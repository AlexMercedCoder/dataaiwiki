---
import network from '../../network/network.json';

const { groups, allSitesUrl, allSitesLabel } = network.footer;

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-container container">
    <nav class="footer-groups" aria-label="Alex Merced network">
      {groups.map(group => (
        <div class="footer-group">
          <h2 class="footer-group-title">{group.title}</h2>
          <div class="footer-links-grid">
            {group.links.map(link => (
              <a href={link.url} class="footer-link">{link.title}</a>
            ))}
          </div>
        </div>
      ))}
      <p class="footer-all-sites">
        <a href={allSitesUrl} class="footer-link">{allSitesLabel}</a>
      </p>
    </nav>
    
    <div class="footer-bottom">
      <p class="footer-newsletter">
        Two free weekly newsletters from Alex Merced: an AI newsletter on Thursdays and an Apache
        lakehouse newsletter on Fridays.
        <a href="https://amdatalakehouse.substack.com" target="_blank" rel="noopener noreferrer">Subscribe on Substack</a>
      </p>
      <p class="copyright">&copy; {currentYear} Data & AI Wiki. Developed under the Refero Editorial Style.</p>
    </div>
  </div>
</footer>

<style>
  .footer-newsletter {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
  }

  .site-footer {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-canvas-parchment);
    padding: 3rem 0;
    margin-top: auto;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .footer-groups {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .footer-group-title {
    margin: 0 0 0.75rem;
    padding: 0;
    border: 0;
    font-size: 1.1rem;
  }

  .footer-all-sites {
    margin: 0;
    display: flex;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1.5rem;
  }

  .footer-link {
    color: var(--color-text-main);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    padding: 0.5rem;
    border: 1px dashed transparent;
    text-align: center;
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }

  .footer-link:hover {
    color: var(--color-alert-crimson);
    border-color: var(--color-alert-crimson);
    background-color: var(--color-canvas-parchment);
  }

  .footer-bottom {
    display: flex;
    justify-content: center;
    border-top: 1px dashed var(--color-border);
    padding-top: 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .copyright {
    margin: 0;
    text-align: center;
  }

  /* Screen Reader helper */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
