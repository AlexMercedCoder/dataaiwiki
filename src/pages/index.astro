---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('wiki');
const articleCount = entries.length;
const nonHomeEntries = entries.filter(e => e.id !== 'home');

// Get up to 3 featured articles to showcase
const featuredArticles = nonHomeEntries.slice(0, 3);
---

<BaseLayout title="Data & AI Wiki" description="Alex Merced's Data & AI Wiki: short definitions of AI and data terms, from agents and retrieval to semantic layers and lakehouses." kind="termset">
  <main id="main-content" class="hero-page">
    <section class="hero-section">
      <div class="hero-container container">
        <h1 class="hero-title">The Data &amp; AI Wiki</h1>
        <p class="hero-subtitle">
          An open editorial wiki from <a href="https://alexmerced.com" target="_blank" rel="noopener noreferrer">Alex Merced</a>, covering Lakehouse architectures, semantic data integration, open source tools, and AI concepts.
        </p>
        
        <div class="hero-actions">
          <a href="/wiki/" class="btn btn-primary">Start Reading</a>
          <button id="hero-search-trigger" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem; vertical-align: middle;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            Search Articles
          </button>
        </div>
      </div>
    </section>

    <section class="stats-section">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-card">
            <span class="stat-number">{articleCount}</span>
            <span class="stat-label">Wiki Articles</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">100%</span>
            <span class="stat-label">Open Source</span>
          </div>
          <div class="stat-card">
            <span class="stat-number">Static</span>
            <span class="stat-label">Fast Execution</span>
          </div>
        </div>
      </div>
    </section>

    <section class="info-section">
      <div class="container">
        <div class="info-grid">
          <div class="info-text-block">
            <h2 class="info-section-title">Modern Data Architecture</h2>
            <p class="info-text">
              The modern data ecosystem is moving rapidly away from proprietary data warehouses toward open, modular architectures. By separating compute from storage, organizations can run multiple analytical engines concurrently against a single copy of data, reducing vendor lock-in and minimizing expensive data copies.
            </p>
            <p class="info-text">
              At the center of this shift is the <strong>Data Lakehouse</strong>, enabled by open-source table formats like Apache Iceberg, Delta Lake, and Apache Hudi. These formats bring transaction safety, schema evolution, and time-travel capabilities directly to files stored in object storage.
            </p>
          </div>
          <div class="info-text-block">
            <h2 class="info-section-title">Semantic Layers &amp; AI</h2>
            <p class="info-text">
              As data storage becomes open and standardized, the focus shifts to data management and consumption. The <strong>Semantic Layer</strong> acts as a unified abstraction layer over heterogeneous data sources, providing business users and analytics engines with consistent definitions, security, and governance.
            </p>
            <p class="info-text">
              Simultaneously, the rise of <strong>Generative AI</strong> and Large Language Models (LLMs) requires robust, real-time access to clean organizational data. Technologies like RAG (Retrieval-Augmented Generation) bridge the gap between unstructured knowledge and structured data catalogs, enabling intelligent applications to deliver high-context answers.
            </p>
          </div>
        </div>
      </div>
    </section>

    {featuredArticles.length > 0 && (
      <section class="featured-section">
        <div class="container">
          <h2 class="section-title">Featured Articles</h2>
          <div class="featured-grid">
            {featuredArticles.map(article => (
              <div class="featured-card">
                <h3 class="featured-title">{article.data.title}</h3>
                <p class="featured-excerpt">
                  {article.data.description || "Discover architectural details, concept walkthroughs, and technical platforms inside the wiki."}
                </p>
                <a href={`/wiki/${article.id}/`} class="card-link">Read Article &rarr;</a>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </main>
</BaseLayout>

<script>
  // Setup the hero search trigger to invoke the Header search modal
  const setupHeroSearch = () => {
    const heroSearchTrigger = document.getElementById('hero-search-trigger');
    const headerSearchTrigger = document.getElementById('search-trigger');
    if (heroSearchTrigger && headerSearchTrigger) {
      heroSearchTrigger.addEventListener('click', () => {
        headerSearchTrigger.click();
      });
    }
  };

  setupHeroSearch();
  document.addEventListener('astro:after-swap', setupHeroSearch);
</script>

<style>
  .hero-page {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .hero-section {
    padding: 6rem 0 4rem 0;
    text-align: center;
    border-bottom: 1px dashed var(--color-border);
  }

  .hero-title {
    font-size: 5rem;
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-bottom: 2rem;
    font-weight: normal;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto 3rem auto;
    color: var(--color-text-muted);
  }

  .hero-subtitle a {
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .btn {
    font-family: var(--font-primary);
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 2rem;
    cursor: pointer;
    text-decoration: none;
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }

  .btn-primary {
    background-color: var(--color-cocoa-ink);
    color: var(--color-canvas-parchment);
  }

  .btn-primary:hover {
    background-color: var(--color-alert-crimson);
    border-color: var(--color-alert-crimson);
    color: var(--color-pure-white);
  }

  .btn-secondary {
    background-color: var(--color-pure-white);
    color: var(--color-cocoa-ink);
  }

  .btn-secondary:hover {
    background-color: var(--color-canvas-parchment);
    border-color: var(--color-alert-crimson);
    color: var(--color-alert-crimson);
  }

  /* Stats Section */
  .stats-section {
    padding: 3rem 0;
    border-bottom: 1px dashed var(--color-border);
    background-color: rgba(71, 36, 37, 0.02);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 3.5rem;
    line-height: 1;
    color: var(--color-text-main);
  }

  .stat-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    font-weight: 700;
  }

  /* Info Section */
  .info-section {
    padding: 5rem 0;
    border-bottom: 1px dashed var(--color-border);
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4rem;
  }

  .info-section-title {
    font-size: 2.2rem;
    margin-bottom: 1.5rem;
    color: var(--color-text-main);
  }

  .info-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .info-text strong {
    color: var(--color-text-main);
  }

  /* Featured Section */
  .featured-section {
    padding: 5rem 0;
  }

  .section-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
  }

  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }

  .featured-card {
    background-color: var(--color-pure-white);
    border: 1px solid var(--color-border);
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
  }

  .featured-card:hover {
    border-color: var(--color-alert-crimson);
  }

  .featured-title {
    font-size: 1.6rem;
    margin-bottom: 1rem;
    line-height: 1.1;
  }

  .featured-excerpt {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .card-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text-main);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .featured-card:hover .card-link {
    color: var(--color-alert-crimson);
  }

  @media (max-width: 767px) {
    .hero-title {
      font-size: 3.5rem;
    }
    
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    
    .info-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    
    .hero-section {
      padding: 4rem 0 3rem 0;
    }
  }
</style>
