---
import { getCollection, render } from 'astro:content';
import WikiLayout from '../../layouts/WikiLayout.astro';
import { practicalExamples } from '../../data/practical-examples';
import { deepTermSlugs } from '../../data/deep-term-slugs';

export async function getStaticPaths() {
  const entries = await getCollection('wiki');
  return entries.map(entry => {
    // Map "home" to undefined so it serves as the index page at /wiki/
    const slug = entry.id === 'home' ? undefined : entry.id;
    return {
      params: { slug },
      props: { entry }
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const practical = practicalExamples[entry.id];

// Listing pages carry the DefinedTermSet; every other page is one DefinedTerm.
const listingIds = new Set(['home', 'terms']);
const sectionIds = new Set(['individuals', 'vendor-platforms']);
const kind = listingIds.has(entry.id) ? 'termset' : sectionIds.has(entry.id) ? undefined : 'term';
const siteUrl = Astro.site ? Astro.site.toString() : 'https://dataaiwiki.com/';
const terms = entry.id === 'terms'
  ? (await getCollection('wiki'))
      .filter(e => !listingIds.has(e.id) && !sectionIds.has(e.id))
      .sort((a, b) => a.data.title.localeCompare(b.data.title))
      .map(e => ({ name: e.data.title, url: new URL(`/wiki/${e.id}/`, siteUrl).toString() }))
  : undefined;
---

<WikiLayout frontmatter={entry.data} kind={kind} terms={terms}>
  <Content />
  {entry.id !== 'home' && <aside style="margin-top:2rem;padding:1.25rem;border:1px solid #b7c6d4;border-radius:8px;">
    {practical && <><h2>Example</h2><p>{practical.example}</p></>}
    <h2>Go deeper</h2>
    <p>{deepTermSlugs.includes(entry.id) ? <a href={`https://dataengnr.com/terms/${entry.id}/`}>Read the in-depth DataEngnr guide →</a> : <a href="https://datalakehouse.help/">Browse hands-on data and AI guides →</a>}</p>
  </aside>}
</WikiLayout>
